{
  "manifest_version": 3,
  "name": "WasmCheat",
  "version": "0.1.0",
  "description": "Find a number in a WebAssembly game and change it, from a DevTools panel or an MCP agent. Every change is logged.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "tabs", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["worker-agent.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WasmCheat",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page-agent.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
