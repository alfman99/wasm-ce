{
  "manifest_version": 3,
  "name": "WasmCheat",
  "version": "0.2.0",
  "description": "Change any web app or browser game from an AI agent or a DevTools panel: run JavaScript, edit WebAssembly memory, keep it as a mod.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "tabs", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["worker-agent.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WasmCheat",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  }
}
